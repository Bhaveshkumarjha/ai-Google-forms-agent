# Copy to .env and fill in. Never commit .env.

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# https://aistudio.google.com/apikey (free tier; keep billing OFF)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local development only
FLASK_DEBUG=1
# DEV_LOGIN=1   # lets you sign in without Google to test. NEVER enable in production.

# Production (Render etc.): FLASK_DEBUG=0, TRUST_PROXY=1, DATABASE_URL=postgresql://...
# DATABASE_URL=sqlite:///forms_agent.db
# TRUST_PROXY=1
